# Copy to .env. Everything here is free.

# rules | ollama
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
# docker compose sets this to the ollama container; use localhost if you run
# Ollama directly on your machine.
OLLAMA_BASE_URL=http://localhost:11434

# Reference pricing (USD per million tokens). Your real cost with Ollama is $0;
# set these to an API's list price to report what the same workload would cost
# there. Leave at 0 to report actual cost.
INPUT_COST_PER_MTOK=0
OUTPUT_COST_PER_MTOK=0

# Langfuse Cloud Hobby plan: free, no credit card, 50k units/month.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

REVIEW_THRESHOLD=high
